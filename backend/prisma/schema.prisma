generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  user
  moderator
  admin
}

enum account_status {
  active
  suspended
  banned
}

enum report_status {
  open
  under_review
  resolved
  rejected
}

enum report_reason_category {
  fraud
  abuse
  spam
  other
}

enum conversation_type {
  direct
}

model alerts {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  crypto_id    Int
  alert_type   String    @db.VarChar(20)
  threshold    Decimal   @db.Decimal(18, 8)
  is_triggered Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  triggered_at DateTime?
  cryptos      cryptos   @relation(fields: [crypto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model crypto_prices {
  id                 Int       @id @default(autoincrement())
  crypto_id          Int
  price_usd          Decimal   @db.Decimal(18, 8)
  volume_usd_24h     Decimal?  @db.Decimal(20, 2)
  market_cap_usd     Decimal?  @db.Decimal(20, 2)
  change_percent_24h Decimal?  @db.Decimal(10, 4)
  fetched_at         DateTime? @default(now()) @db.Timestamp(6)
  high_24h           Decimal?  @db.Decimal
  low_24h            Decimal?  @db.Decimal
  circulating_supply Decimal?  @db.Decimal
  total_supply       Decimal?  @db.Decimal
  ath                Decimal?  @db.Decimal
  ath_change_percent Decimal?  @db.Decimal
  atl                Decimal?  @db.Decimal
  atl_change_percent Decimal?  @db.Decimal
  cryptos            cryptos   @relation(fields: [crypto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cryptos {
  id                     Int                      @id @default(autoincrement())
  symbol                 String                   @unique @db.VarChar(10)
  name                   String                   @db.VarChar(50)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  alerts                 alerts[]
  crypto_prices          crypto_prices[]
  indicators_history     indicators_history[]
  portfolio_transactions portfolio_transactions[]
}

model indicators_history {
  id            Int      @id @default(autoincrement())
  crypto_id     Int?
  fetched_at    DateTime @db.Timestamp(6)
  sma7          Decimal? @db.Decimal
  sma30         Decimal? @db.Decimal
  variation_24h Decimal? @db.Decimal
  cryptos       cryptos? @relation(fields: [crypto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id         Int      @id @default(autoincrement())
  pseudo     String   @unique
  email      String   @unique
  password   String?
  role       user_role      @default(user)
  status     account_status @default(active)
  banned_until DateTime?
  banned_at    DateTime?
  ban_reason   String?
  banned_by_id Int?
  created_at DateTime @default(now())

  banned_by     users?  @relation("user_banned_by", fields: [banned_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  banned_users  users[] @relation("user_banned_by")

  portfolio    portfolios?
  firebase_uid String?     @unique

  discord_username   String?
  discord_user_id    String?  @unique
  discord_connected_at DateTime?

  alerts alerts[]

  reports_received reports[] @relation("reported_user")
  reports_made     reports[] @relation("reported_by")
  reports_decided  reports[] @relation("admin_decision_by")

  audit_logs_actor  audit_logs[] @relation("audit_actor")
  audit_logs_target audit_logs[] @relation("audit_target")

  conversation_participants conversation_participants[]
  messages_sent messages[] @relation("message_sender")
}

model portfolios {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  balance    Float    @default(0)
  total_deposited Float @default(0)
  created_at DateTime @default(now())

  user         users                    @relation(fields: [user_id], references: [id])
  transactions portfolio_transactions[]
}

model reports {
  id                   Int                   @id @default(autoincrement())
  reported_user_id     Int
  reported_by_id       Int
  reason_category      report_reason_category
  reason_text          String
  evidence             String?
  status               report_status         @default(open)

  admin_decision_by_id Int?
  admin_decision_at    DateTime?
  admin_decision_note  String?

  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  reported_user        users                 @relation("reported_user", fields: [reported_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reported_by          users                 @relation("reported_by", fields: [reported_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_decision_by    users?                @relation("admin_decision_by", fields: [admin_decision_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  audit_logs           audit_logs[]          @relation("audit_report")

  @@index([reported_user_id])
  @@index([status])
  @@index([created_at])
}

model audit_logs {
  id             Int      @id @default(autoincrement())
  actor_id       Int?
  action         String   @db.VarChar(50)
  target_user_id Int?
  report_id      Int?
  metadata       Json?
  created_at     DateTime @default(now())

  actor       users?   @relation("audit_actor", fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  target_user users?   @relation("audit_target", fields: [target_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  report      reports? @relation("audit_report", fields: [report_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([action])
  @@index([actor_id])
  @@index([target_user_id])
  @@index([created_at])
}

model portfolio_transactions {
  id           Int      @id @default(autoincrement())
  portfolio_id Int
  crypto_id    Int
  type         String // buy / sell
  quantity     Float
  price_usd    Float
  timestamp    DateTime @default(now())

  portfolio portfolios @relation(fields: [portfolio_id], references: [id])
  crypto    cryptos    @relation(fields: [crypto_id], references: [id])
}

model app_settings {
  key                 String   @id @db.VarChar(50)
  maintenance_enabled Boolean  @default(false)
  maintenance_message String?  @db.VarChar(200)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model conversations {
  id         Int               @id @default(autoincrement())
  type       conversation_type @default(direct)
  direct_key String?           @unique @db.VarChar(100)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  participants conversation_participants[]
  messages     messages[]

  @@index([updated_at])
}

model conversation_participants {
  id              Int      @id @default(autoincrement())
  conversation_id Int
  user_id         Int
  joined_at       DateTime @default(now())

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversation_id, user_id])
  @@index([user_id])
  @@index([conversation_id])
}

model messages {
  id              Int      @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  body            String   @db.VarChar(2000)
  created_at      DateTime @default(now())

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender       users        @relation("message_sender", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at])
  @@index([sender_id])
}
